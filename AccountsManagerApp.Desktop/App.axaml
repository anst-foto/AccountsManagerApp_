<Application
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="AccountsManagerApp.Desktop.App"
  RequestedThemeVariant="Light">

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="/Styles/ButtonStyles.axaml" />
    <StyleInclude Source="Styles/TextStyles.axaml" />
    <StyleInclude Source="Styles/TextBoxStyles.axaml" />
  </Application.Styles>

  <Application.Resources>
    <x:String x:Key="Title">Менеджер аккаунтов</x:String>
  </Application.Resources>
</Application>